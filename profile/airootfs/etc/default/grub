# NeOS GRUB defaults for boot reliability on common storage and VM targets.

GRUB_DEFAULT=0
# Long enough to reach the menu (and the snapshot submenu) when recovering.
GRUB_TIMEOUT=3
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="NeOS"
# Performance Optimizations
# - nowatchdog: Disable watchdog timer to reduce CPU interrupts
# - intel_pstate=enable: Force Intel P-state driver (if valid/supported)
# - amd_pstate=active: Enable AMD P-state active mode for modern Ryzen CPUs
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nowatchdog intel_pstate=enable amd_pstate=active"
GRUB_CMDLINE_LINUX=""

# Preload modules to improve bootloader startup reliability across filesystems.
# Keep this list conservative to avoid unnecessary probes on unsupported media.
GRUB_PRELOAD_MODULES="part_gpt part_msdos ext2 btrfs"

# Disable submenus for a simpler boot menu experience.
GRUB_DISABLE_SUBMENU=true

# The same medieval graphical menu is shipped on the ISO and installed disk.
GRUB_THEME="/usr/share/grub/themes/neos-medieval/theme.txt"
GRUB_FONT="/usr/share/grub/themes/neos-medieval/dejavu_16.pf2"
GRUB_GFXMODE="1024x768,auto"
GRUB_TERMINAL_OUTPUT="gfxterm"

# Name of the snapshot submenu that grub-btrfs adds (docs/user-guide/TROUBLESHOOTING.md).
# Exported because grub-mkconfig only passes its own GRUB_* variables to the
# /etc/grub.d scripts.
export GRUB_BTRFS_SUBMENUNAME="NeOS snapshots"

# List Windows and other installed systems in the menu (dual boot). GRUB 2.06+
# skips os-prober unless this is set explicitly.
GRUB_DISABLE_OS_PROBER=false
