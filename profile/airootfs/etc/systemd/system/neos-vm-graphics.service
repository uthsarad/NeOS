[Unit]
Description=NeOS VM graphics fallback (software rendering and graphical seat)
# Must apply before the display manager starts so the login session inherits
# the environment. Skipped automatically on bare metal.
Before=display-manager.service sddm.service
After=systemd-udevd.service systemd-modules-load.service
ConditionVirtualization=vm

[Service]
Type=oneshot
Environment=LC_ALL=C
ProtectSystem=strict
# Write the software-rendering environment and, only for an unbound VMware VGA
# adapter without DRM, a transient seat rule below /run/udev/rules.d.
ReadWritePaths=/etc /run/udev
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RemainAfterExit=yes
ExecStart=/usr/local/bin/neos-vm-graphics

[Install]
WantedBy=multi-user.target
