[Unit]
Description=NeOS live boot probe (serial marker for automated boot verification)
Documentation=https://github.com/uthsarad/NeOS/blob/testing/reports/v2026.09.22/UPDATES_NEEDED.md
# Check the desktop as soon as SDDM can start it. graphical.target may still be
# waiting for unrelated work, including network time synchronization offline.
# This unit is live-only (excluded from the installed-system overlay).
After=sddm.service neos-liveuser-setup.service
Wants=sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Hardened like every other NeOS unit (tests/verify_service_hardening.sh).
# /dev is not covered by ProtectSystem, so writing the serial marker still works.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Wait for a real graphical live-user session, not merely graphical.target.
TimeoutStartSec=200
ExecStart=/usr/local/bin/neos-boot-probe

[Install]
WantedBy=graphical.target
