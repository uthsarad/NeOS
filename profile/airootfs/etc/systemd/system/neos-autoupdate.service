[Unit]
Description=NeOS Autoupdate Service
ConditionPathExists=!/run/archiso

[Service]
Type=oneshot
Environment=LC_ALL=C
ExecStart=/usr/local/bin/neos-autoupdate.sh
# System-wide package upgrades (`pacman -Syu` + libalpm hooks + `snapper`) must
# write across /, /.snapshots, /usr, /boot, /etc, /var and /opt, drop privileges
# to `alpm` (DownloadUser) and logged-in desktop users (`runuser`), and run
# kernel/udev/initramfs post-transaction hooks. Keep the isolation directives
# that do not break package management or snapshot creation:
PrivateTmp=yes
ProtectHome=read-only
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
