[Unit]
Description=NeOS accessibility bootstrap (console speech when accessibility=on; Orca starts in the desktop session)
# Must run before the display manager starts so speech is available during
# the graphical login screen as well as on the virtual console.
After=sysinit.target
Before=display-manager.service sddm.service

[Service]
Type=oneshot
Environment=LC_ALL=C
ProtectSystem=strict
# Only on a screen reader boot: lets the root installer onto the user's
# accessibility bus (see the script).
ReadWritePaths=-/usr/share/defaults/at-spi2
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RemainAfterExit=yes
ExecStart=/usr/local/bin/neos-accessibility

[Install]
WantedBy=multi-user.target
