/* ---- Buttons ------------------------------------------------------------- */
QPushButton {
    background-color: #141b33;
    color: #dfe3ef;
    border: 1px solid #2a3354;
    border-radius: 8px;
    padding: 8px 22px;
    min-height: 20px;
    font-weight: 500;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: #1c2546;
    border-color: #3a4670;
}
QPushButton:pressed {
    background-color: #0f1530;
}
QPushButton:disabled {
    background-color: #11162a;
    color: #5a607a;
    border-color: #1c2444;
}

