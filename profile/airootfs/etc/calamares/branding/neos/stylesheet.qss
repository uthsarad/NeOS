    border: 1px solid #222a47;
    border-radius: 10px;
    margin-top: 16px;
    padding-top: 10px;
    background: transparent;
    font-size: 10pt;
    color: #c0c4d8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #9aa0b6;
    font-weight: 600;
}

