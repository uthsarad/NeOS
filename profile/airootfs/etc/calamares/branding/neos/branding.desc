---
componentName:  neos

welcomeStyleCalamares:   false
welcomeExpandingLogo:    true
windowResizable:         true
windowSize:              1024,720
windowCentered:          true
windowPlacement:         center

# Traditional widget sidebar (progress) + bottom navigation buttons.
sidebar:    widget
navigation: widget

strings:
    productName:         NeOS
    shortProductName:    NeOS
    # These four are display-only and are stamped with the real build version by
    # CI (build-iso.yml, "Generate codename and set ISO version"). The committed
    # values are the fallback used by an unmodified local build — never a date,
    # which is stale the day after it is written
    # (reports/v2026.09.22/UPDATES_NEEDED.md, M10).
    productVersion:      Beta
    shortProductVersion: Beta
    versionedName:       NeOS Beta
    shortVersionedName:  NeOS Beta
    bootloaderEntryName: NeOS
    # URLs for the welcome-page info buttons. Calamares reads the URLs from here;
    # welcome.conf's show*Url booleans decide which buttons appear. Without these
    # the welcome page rendered with no support/known-issues/release-notes links.
    # These MUST name the canonical repository: this repository is a fork whose
    # Issues are disabled, so a fork URL ships a dead end to every user
    # (guarded by tests/verify_repo_urls.sh).
    productUrl:          "https://github.com/uthsarad/NeOS"
    supportUrl:          "https://github.com/uthsarad/NeOS/issues"
    knownIssuesUrl:      "https://github.com/uthsarad/NeOS/issues"
    # Releases are cut from `testing` while `main` stays idle until the official
    # public release, so the notes link follows the branch releases come from.
    releaseNotesUrl:     "https://github.com/uthsarad/NeOS/blob/testing/CHANGELOG.md"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

# NeOS brand palette — single source of truth: tools/palette.json.
# NOTE: current Calamares uses the CAPITALISED Sidebar* keys; the old lowercase
# sidebarBackground/sidebarTextHighlight names are ignored, so the previous theming
# never applied. The current step gets an accent-blue background with white text.
style:
   SidebarBackground:        "#0A0E1A"
   SidebarText:              "#AEB4C7"
   SidebarBackgroundCurrent: "#38bdf8"
   SidebarTextCurrent:       "#FFFFFF"

# Let users upload installer logs for support (calamares "Upload" button).
uploadServer:
    type:      "fiche"
    url:       "http://termbin.com:9999"
    sizeLimit: -1
