# Configuration file for snapper on root filesystem

# Subvolume to snapshot
SUBVOLUME="/"

# Filesystem type (required by libsnapper; omitting FSTYPE causes
# InvalidConfigException on every `snapper -c root` invocation)
FSTYPE="btrfs"

# Btrfs quota group (optional; /home, /var/cache and /var/log live in separate
# subvolumes created by etc/calamares/modules/mount.conf so they are already
# excluded from root snapshots)
QGROUP=""

# TIMELINE
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="10"
TIMELINE_LIMIT_DAILY="10"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_YEARLY="0"

# NUMBER
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="10"

# SPACE
SPACE_LIMIT="0.5"

# FREE_SPACE
FREE_SPACE_LIMIT="0.2"

# SYNC_ACL
SYNC_ACL="no"

# BACKGROUND_COMPARISON
BACKGROUND_COMPARISON="yes"

# SNAPDIFFS
SNAPDIFFS="yes"

# ALLOW_GROUPS
ALLOW_GROUPS="wheel"

# ALLOW_USERS
ALLOW_USERS=""

# USER_ALLOW_GROUPS
USER_ALLOW_GROUPS=""

# USER_ALLOW_USERS
USER_ALLOW_USERS=""
