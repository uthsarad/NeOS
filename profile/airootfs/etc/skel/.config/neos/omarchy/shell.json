{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "neos.clock",
    "layout": {
      "left": [
        {
          "id": "neos.menu"
        },
        {
          "id": "neos.workspaces"
        }
      ],
      "center": [
        {
          "id": "neos.indicators"
        },
        {
          "id": "neos.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "neos.keyboard-layout"
        },
        {
          "id": "neos.weather"
        },
        {
          "id": "neos.system-update"
        }
      ],
      "right": [
        {
          "id": "neos.tray"
        },
        {
          "id": "neos.agents"
        },
        {
          "id": "neos.bluetooth"
        },
        {
          "id": "neos.network"
        },
        {
          "id": "neos.audio"
        },
        {
          "id": "neos.monitor"
        },
        {
          "id": "neos.power"
        }
      ]
    }
  },
  "plugins": []
}
