/* Require admin authentication for PackageKit system modifications to prevent unprivileged users from installing/removing packages.
 *
 * Live-session exception: the live user has passwordless sudo but NO password
 * (passwd -d), so AUTH_ADMIN can never be satisfied and Discover installs
 * would fail with an unauthenticatable prompt. The live session is a RAM
 * overlay anyway, so passwordless PackageKit there matches the live sudoers
 * rule and changes nothing security-wise. Installed systems have no
 * `liveuser` account, so this branch is inert there and the strict path
 * below applies to everyone.
 */
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.packagekit.") == 0) {
        if (action.id == "org.freedesktop.packagekit.package-install" ||
            action.id == "org.freedesktop.packagekit.package-remove" ||
            action.id == "org.freedesktop.packagekit.system-update" ||
            action.id == "org.freedesktop.packagekit.system-trust-source" ||
            action.id == "org.freedesktop.packagekit.system-sources-configure" ||
            action.id == "org.freedesktop.packagekit.offline-update") {

            if (subject.user == "liveuser") {
                return polkit.Result.YES;
            } else if (subject.isInGroup("wheel")) {
                return polkit.Result.AUTH_ADMIN;
            } else {
                return polkit.Result.NO;
            }
        }
    }
});
