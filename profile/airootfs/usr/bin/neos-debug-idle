#!/bin/bash

# neos:summary=Show idle, screensaver, and lock diagnostics
# neos:group=debug
# neos:args=[log-lines]
# neos:examples=neos debug idle | neos-debug-idle 400

lines=${1:-200}
if [[ ! $lines =~ ^[0-9]+$ ]]; then
  lines=200
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "Time"
date -Is

section "Idle IPC status"
neos-shell idle status 2>&1 | jq . 2>/dev/null || neos-shell idle status 2>&1 || true

section "Quickshell instances"
quickshell list -p "$NEOS_PATH/shell" --any-display 2>&1 || true

section "Recent idle logs"
quickshell --no-color log -p "$NEOS_PATH/shell" --any-display --tail "$lines" --log-times -r 'quickshell.wayland.idle_notify=true' 2>&1 \
  | grep -Ei 'neos idle|idle_notify|screensaver|lock|error|warn|failed' || true

section "Persisted shell log"
journalctl -t neos-shell -n "$lines" --no-pager --quiet 2>/dev/null || true

section "Relevant processes"
ps -eo pid=,args= \
  | grep -E 'quickshell -n -p|neos-system-sleep-monitor|systemd-inhibit.*Lock screen before suspend|org\.neos\.screensaver|neos-screensaver|(^|/| )ttfx( |$)' \
  | grep -v grep || true

section "Sleep lock service"
systemctl --user status neos-sleep-lock.service --no-pager 2>/dev/null || true

section "Hyprland screensaver clients"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.class == "org.neos.screensaver" or .initialClass == "org.neos.screensaver") | [.pid,.class,.initialClass,.title,.focusHistoryID] | @tsv' || true

section "Idle inhibitors"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.inhibitingIdle == true or ((.tags // []) | index("noidle"))) | [.pid,.class,.title,((.tags // []) | join(",")),.inhibitingIdle] | @tsv' || true

section "Screensaver detector"
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.neos.screensaver" or .initialClass == "org.neos.screensaver")' >/dev/null; then
  echo "running-window"
elif pgrep -f '[o]rg.neos.screensaver' >/dev/null; then
  echo "running-process"
elif neos-toggle-enabled screensaver-off; then
  echo "disabled"
else
  echo "stopped"
fi

section "Lock detector"
neos-shell lock status 2>&1 | jq . 2>/dev/null || neos-shell lock status 2>&1 || true
