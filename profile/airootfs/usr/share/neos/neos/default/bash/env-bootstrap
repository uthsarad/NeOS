# Single source of truth for NEOS_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/neos.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-neos          (Hyprland session via uwsm)
#   /usr/share/neos/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/neos.conf is written by neos-dev-link and reset by
# neos-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/neos.conf ]; then
  . /etc/neos.conf
  : "${NEOS_PATH:=/usr/share/neos}"
else
  NEOS_PATH=/usr/share/neos
fi
export NEOS_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/neos-* via the neos package — prepending
# /usr/share/neos/bin would just be noise.
if [ "$NEOS_PATH" != /usr/share/neos ]; then
  case ":$PATH:" in
    *":${NEOS_PATH%/}/bin:"*) ;;
    *) PATH="${NEOS_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
