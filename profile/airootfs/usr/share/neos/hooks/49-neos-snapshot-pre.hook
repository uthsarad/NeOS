[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Creating pre-transaction Btrfs snapshot...
When = PreTransaction
Exec = /usr/bin/bash -c 'if [ -z "${NEOS_AUTOUPDATE_ACTIVE:-}" ] && command -v snapper >/dev/null 2>&1 && [ -e /etc/snapper/configs/root ] && [ "$(stat -f -c %T / 2>/dev/null)" = "btrfs" ] && [ ! -L /run/neos-pacman-pre-snap.id ]; then umask 077; rm -f /run/neos-pacman-pre-snap.id; SNAP_ID=$(snapper --config=root create --type pre --print-number --cleanup-algorithm number --description "Pre-package-operation-$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true); case "$SNAP_ID" in ""|*[!0-9]*) ;; *) printf "%s\n" "$SNAP_ID" > /run/neos-pacman-pre-snap.id ;; esac; fi'
