#!/bin/bash
# [BOLT] Optimize PCI detection to minimize subprocess overhead.
# [SENTINEL] Audit for command injection risks when parsing PCI output.
# [PALETTE] Add semantic visual anchors or UI integration for detection state.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

echo -e "\e[1;34mℹ️  Scanning for Nvidia GPUs...\e[0m"
nvidia_found=0
shopt -s nullglob
for vendor in /sys/bus/pci/devices/*/vendor; do
    if [[ -f "$vendor" ]]; then
        read -r vid < "$vendor"
        if [[ "$vid" == "0x10de" ]]; then
            nvidia_found=1
            break
        fi
    fi
done
shopt -u nullglob

if (( nvidia_found )); then
    echo -e "\e[1;32m✅ Nvidia GPU detected.\e[0m"
    if command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        kdialog --icon dialog-information --title "NeOS Hardware Setup - GPU Detection" --passivepopup "Nvidia GPU detected." 5 &
    fi
else
    echo -e "\e[1;33m⚠️  No Nvidia GPU detected.\e[0m"
fi
