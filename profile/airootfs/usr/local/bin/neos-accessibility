set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

<<<<<<< HEAD
CMDLINE_FILE="${NEOS_A11Y_CMDLINE:-/proc/cmdline}"   # overridable for tests

if ! grep -qw 'accessibility=on' "$CMDLINE_FILE" 2>/dev/null; then
    exit 0   # standard boot: no speech needed
fi

if [[ "${1:-}" == "--session" ]]; then
    if ! command -v orca >/dev/null 2>&1; then
        logger -t neos-accessibility "accessibility=on but orca is not installed" || true
        exit 0
    fi
    # Plasma's own switch (System Settings > Accessibility > Screen Reader), so
    # the setting shows as on and kaccess keeps Orca running on later logins.
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kaccessrc --group ScreenReader --key Enabled true || true
    fi
    if pgrep -u "$(id -u)" -f '(^|/)orca( |$)' >/dev/null 2>&1; then
        exit 0   # already speaking (kaccess got there first)
    fi
    logger -t neos-accessibility "accessibility=on — starting Orca for $(id -un)" || true
    exec orca --replace
fi

logger -t neos-accessibility "accessibility=on detected — starting espeakup"
systemctl start espeakup.service
logger -t neos-accessibility "espeakup started successfully"

# Let the installer be read aloud. Calamares runs as root, and Orca reads apps
# over the live user's accessibility bus, which only admits its owner, so the
# installer was silent. Allowing root onto that bus grants nothing root does
# not already have; it is done only on a screen reader boot of the live image.
# neos-welcome then hands Calamares the bus address (AT_SPI_BUS_ADDRESS).
A11Y_CONF="${NEOS_A11Y_BUSCONF:-/usr/share/defaults/at-spi2/accessibility.conf}"
if [[ -f "$A11Y_CONF" && ! -L "$A11Y_CONF" ]] && ! grep -q '<allow user="root"/>' "$A11Y_CONF"; then
    sed -i 's#</busconfig>#  <!-- NeOS: the installer runs as root (neos-accessibility) -->\n  <policy context="default"><allow user="root"/></policy>\n</busconfig>#' "$A11Y_CONF"
    logger -t neos-accessibility "root may join the accessibility bus (installer speech)"
fi
