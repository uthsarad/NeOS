    def launch_drivers(self):
        try:
            subprocess.Popen(['/usr/local/bin/neos-driver-manager'])
        except Exception as e:
            print(f"Error launching driver manager: {e}", file=sys.stderr)

    def launch_discover(self):
        try:
            subprocess.Popen(['plasma-discover'])
        except Exception:
            try:
                subprocess.Popen(['discover'])
            except Exception as e:
                print(f"Error launching app center: {e}", file=sys.stderr)


def is_live_mode():
    return (
        os.path.exists('/run/archiso/bootmnt') or
        os.path.exists('/run/archiso') or
        os.environ.get('USER') == 'liveuser'
    )


def get_os_version():
    # Always derived from the running system's /etc/os-release — never a
    # hardcoded date. There is deliberately no built-in version literal here:
    # a stale one shipped in the live image and drifted from VERSION
    # (reports/v2026.09.22/UPDATES_NEEDED.md, item 5/M10).
    version_id = ''
    pretty_name = ''
    try:
        if os.path.exists('/etc/os-release'):
            with open('/etc/os-release') as f:
                for line in f:
                    line = line.strip()
                    if line.startswith('VERSION_ID='):
                        version_id = line.split('=', 1)[1].strip('"\'')
                    elif line.startswith('PRETTY_NAME='):
                        pretty_name = line.split('=', 1)[1].strip('"\'')
    except Exception:
        pass
    if version_id:
        return 'v' + version_id
    return pretty_name or 'NeOS'


if __name__ == '__main__':
    if not is_live_mode() and os.path.exists(os.path.expanduser('~/.config/neos/firstboot-done')) and '--force' not in sys.argv:
        sys.exit(0)
    # cidata autoinstall: if an unattended config is already visible, hand off
    # and do not open the welcome window on top of Calamares.
    if is_live_mode() and os.path.isfile('/usr/local/bin/neos-autoinstall'):
        try:
            probe = subprocess.run(
                ['/usr/local/bin/neos-autoinstall', 'probe'],
                capture_output=True, text=True, timeout=8, check=False,
            )
            if 'MODE=UNATTENDED' in (probe.stdout or ''):
                subprocess.Popen(['/usr/local/bin/neos-autoinstall', 'apply'])
                sys.exit(0)
        except Exception:
            pass
