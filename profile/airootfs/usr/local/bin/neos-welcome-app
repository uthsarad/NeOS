#!/usr/bin/env python3
import os
import pathlib
import subprocess
import sys
from PyQt6.QtWidgets import (QApplication, QWidget, QVBoxLayout, QHBoxLayout,
                             QPushButton, QLabel, QGraphicsDropShadowEffect,
                             QFrame)
from PyQt6.QtCore import Qt
from PyQt6.QtGui import QColor


class NeosWelcome(QWidget):
    def __init__(self):
        super().__init__()
        self.initUI()

    def initUI(self):
        self.setWindowTitle('Welcome to NeOS')
        self.setFixedSize(860, 560)
        self.setObjectName('main')

        # Palette: tools/palette.json. Text on accent fills uses the dark
        # onAccent colour (#0a0e1a, 9:1); white on #38bdf8 is only 2.1:1.
        self.setStyleSheet("""
            QWidget#main {
                background: qlineargradient(x1:0, y1:0, x2:0.5, y2:1,
                    stop:0 #0a0e1a, stop:0.4 #0d1224, stop:1 #16203a);
            }
            QLabel#title {
                font-size: 40px;
                font-weight: 800;
                color: #ffffff;
                letter-spacing: 1px;
            }
            QLabel#subtitle {
                font-size: 17px;
                color: #9aa0b6;
            }
            QLabel#version {
                font-size: 12px;
                color: #7a8099;
            }
            QFrame#divider {
                background-color: #38bdf8;
                border: none;
                border-radius: 1px;
            }
            QFrame#card {
                background-color: rgba(17, 23, 46, 0.85);
                border: 1px solid #1c2444;
                border-radius: 12px;
            }
            QFrame#card QLabel {
                background: transparent;
                border: none;
                padding: 0;
            }
            QLabel#cardIcon {
                font-size: 20px;
                font-weight: bold;
                color: #38bdf8;
            }
            QLabel#cardTitle {
                font-size: 13px;
                font-weight: bold;
                color: #e6e9f2;
            }
            QLabel#cardText {
                font-size: 11px;
                color: #9aa0b6;
            }
            QPushButton {
                border-radius: 10px;
                padding: 12px 28px;
                font-size: 15px;
                font-weight: 600;
                min-width: 150px;
            }
            QPushButton#secondary {
                background-color: transparent;
                border: 2px solid #2a3354;
                color: #c0c4d8;
            }
            QPushButton#secondary:hover {
                background-color: rgba(42, 51, 84, 0.45);
                border-color: #4a5a8a;
                color: #ffffff;
            }
            QPushButton#secondary:focus {
                border: 2px solid #7dd3fc;
                color: #ffffff;
            }
            QPushButton#primary {
                background-color: #38bdf8;
                border: 2px solid #38bdf8;
                color: #0a0e1a;
            }
            QPushButton#primary:hover {
                background-color: #7dd3fc;
                border-color: #7dd3fc;
            }
            QPushButton#primary:pressed {
                background-color: #0ea5e9;
                border-color: #0ea5e9;
            }
            QPushButton#primary:focus {
                border: 2px solid #e6e9f2;
            }
        """)

        layout = QVBoxLayout()
        layout.setContentsMargins(56, 40, 56, 32)
        layout.setSpacing(0)
        layout.addStretch(2)

        # ---- Wordmark and tagline ----
        title = QLabel('NeOS')
        title.setObjectName('title')
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)
        layout.addSpacing(4)

        subtitle = QLabel('Arch Linux, refined for everyone.')
        subtitle.setObjectName('subtitle')
        subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(subtitle)
        layout.addSpacing(18)

        divider = QFrame()
        divider.setObjectName('divider')
        divider.setFixedSize(48, 3)
        div_layout = QHBoxLayout()
        div_layout.addStretch()
        div_layout.addWidget(divider)
        div_layout.addStretch()
        layout.addLayout(div_layout)
        layout.addSpacing(28)

        # ---- Feature cards ----
        # Monochrome text glyphs, not emoji: they render in the accent colour
        # with any font and match the installer slideshow.
        features_data = [
            ("\u2713", "Secure by default", "Firewall on, kernel hardened"),
            ("\u00bb", "Fast", "ZRAM swap, BBR networking"),
            ("\u21ba", "Snapshots", "Btrfs snapshot before every update"),
            ("\u25c6", "Your hardware", "NVIDIA, AMD, Intel and VMs"),
        ]
        features_layout = QHBoxLayout()
        features_layout.setSpacing(14)
        features_layout.addStretch()
        for icon, title_text, desc in features_data:
            card = QFrame()
            card.setObjectName('card')
            card.setFixedSize(172, 116)
            card_layout = QVBoxLayout()
            card_layout.setSpacing(4)
            card_layout.setContentsMargins(14, 14, 14, 14)
            for text, name in ((icon, 'cardIcon'), (title_text, 'cardTitle'), (desc, 'cardText')):
                lbl = QLabel(text)
                lbl.setObjectName(name)
                lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
                lbl.setWordWrap(True)
                card_layout.addWidget(lbl)
            card.setLayout(card_layout)
            features_layout.addWidget(card)
        features_layout.addStretch()
        layout.addLayout(features_layout)
        layout.addStretch(2)

        # ---- Actions ----
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(12)
        btn_layout.addStretch()

        def make_button(text, role, tooltip, handler):
            btn = QPushButton(text)
            btn.setObjectName(role)
            btn.setCursor(Qt.CursorShape.PointingHandCursor)
            btn.setToolTip(tooltip)
            btn.setAccessibleName(text)
            btn.setAccessibleDescription(tooltip)
            btn.clicked.connect(handler)
            btn_layout.addWidget(btn)
            return btn

        if is_live_mode():
            buttons = [
                make_button('Try NeOS', 'secondary', 'Keep exploring the live desktop', self.close),
                make_button('Install NeOS', 'primary', 'Install NeOS on this computer', self.run_installer),
            ]
        else:
            buttons = [
                make_button('Drivers', 'secondary', 'Check graphics and hardware drivers', self.launch_drivers),
                make_button('Discover Apps', 'secondary', 'Browse and install applications', self.launch_discover),
                make_button('Get Started', 'primary', 'Close and start using NeOS', self.close),
            ]
        buttons[-1].setDefault(True)
        self.primary_button = buttons[-1]

        glow = QGraphicsDropShadowEffect()
        glow.setBlurRadius(28)
        glow.setColor(QColor(56, 189, 248, 90))
        glow.setOffset(0, 4)
        buttons[-1].setGraphicsEffect(glow)

        btn_layout.addStretch()
        layout.addLayout(btn_layout)
        layout.addSpacing(16)

        version_lbl = QLabel(get_os_version())
        version_lbl.setObjectName('version')
        version_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(version_lbl)

        self.setLayout(layout)
        for first, second in zip(buttons, buttons[1:]):
            self.setTabOrder(first, second)
        self.center_on_screen()

    def showEvent(self, event):
        super().showEvent(event)
        # Focus the primary action once the window exists, so Enter takes the
        # expected path and the focus ring is not on a secondary button.
        self.primary_button.setFocus()

    def center_on_screen(self):
        screen = QApplication.primaryScreen()
        if screen:
            geo = screen.availableGeometry()
            x = (geo.width() - self.width()) // 2
            y = (geo.height() - self.height()) // 2
            self.move(x, y)

    def closeEvent(self, event):
        # On an installed system, closing the window completes first-boot
        # onboarding so it does not open again at the next login.
        if not is_live_mode():
            try:
                config_dir = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
                neos_dir = os.path.join(config_dir, "neos")
                os.makedirs(neos_dir, exist_ok=True)
                pathlib.Path(os.path.join(neos_dir, "firstboot-done")).touch()
            except OSError as e:
                print(f"Error saving onboarding state: {e}", file=sys.stderr)
        super().closeEvent(event)

    def run_installer(self):
        subprocess.Popen(['/usr/local/bin/neos-welcome'])
        self.close()

    def launch_drivers(self):
        try:
            subprocess.Popen(['/usr/local/bin/neos-driver-manager'])
        except Exception as e:
            print(f"Error launching driver manager: {e}", file=sys.stderr)

    def launch_discover(self):
        try:
            subprocess.Popen(['plasma-discover'])
        except Exception:
            try:
                subprocess.Popen(['discover'])
            except Exception as e:
                print(f"Error launching app center: {e}", file=sys.stderr)


def is_live_mode():
    return (
        os.path.exists('/run/archiso/bootmnt') or
        os.path.exists('/run/archiso') or
        os.environ.get('USER') == 'liveuser'
    )


def get_os_version():
    # Always derived from the running system's /etc/os-release — never a
    # hardcoded date. There is deliberately no built-in version literal here:
    # a stale one shipped in the live image and drifted from VERSION
    # (reports/v2026.09.22/UPDATES_NEEDED.md, item 5/M10).
    version_id = ''
    pretty_name = ''
    try:
        if os.path.exists('/etc/os-release'):
            with open('/etc/os-release') as f:
                for line in f:
                    line = line.strip()
                    if line.startswith('VERSION_ID='):
                        version_id = line.split('=', 1)[1].strip('"\'')
                    elif line.startswith('PRETTY_NAME='):
                        pretty_name = line.split('=', 1)[1].strip('"\'')
    except Exception:
        pass
    if version_id:
        return 'v' + version_id
    return pretty_name or 'NeOS'


if __name__ == '__main__':
    if not is_live_mode() and os.path.exists(os.path.expanduser('~/.config/neos/firstboot-done')) and '--force' not in sys.argv:
        sys.exit(0)
    # cidata autoinstall: if an unattended config is already visible, hand off
    # and do not open the welcome window on top of Calamares.
    if is_live_mode() and os.path.isfile('/usr/local/bin/neos-autoinstall'):
        try:
            probe = subprocess.run(
                ['/usr/local/bin/neos-autoinstall', 'probe'],
                capture_output=True, text=True, timeout=8, check=False,
            )
            if 'MODE=UNATTENDED' in (probe.stdout or ''):
                subprocess.Popen(['/usr/local/bin/neos-autoinstall', 'apply'])
                sys.exit(0)
        except Exception:
            pass
    app = QApplication(sys.argv)
    app.setApplicationName('NeOS')
    app.setDesktopFileName('neos-welcome')
    window = NeosWelcome()
    window.show()
    sys.exit(app.exec())
