#!/bin/bash

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# NeOS Operations Hub - Phase 8 Baseline Configuration

if (( EUID == 0 )); then
    echo "Error: This script must not be run as root." >&2
    exit 1
fi

# Close a `kdialog --progressbar` dialog. Its reference is "<bus name> <object
# path>"; it is validated before use so nothing else reaches dbus-send.
close_progress() {
    local ref="$1" dest path
    if [[ "$ref" =~ ^[A-Za-z0-9_.:-]+[[:space:]]/[A-Za-z0-9_/]+$ ]]; then
        read -r dest path <<< "$ref"
        dbus-send --print-reply --dest="$dest" "$path" org.kde.kdialog.ProgressDialog.close >/dev/null 2>&1 || true
    fi
}

# Assign inside the condition so the exit status is tested directly; testing
# $? after a separate command substitution is fragile (SC2181).
if ! ACTION=$(kdialog --icon preferences-system --title "NeOS Operations Hub" \
    --menu "Select a long-term maintenance operation:" \
    "1" "Community Support & Feedback" \
    "2" "Report a System Bug" \
    "3" "Switch Release Channel" \
    "4" "Configure Crash Reporting" \
    "5" "System Snapshot & Rollback" \
    "6" "View System Licensing" \
    "7" "Perform System Update"); then
    exit 0
fi

if [ -z "$ACTION" ]; then
    exit 0
fi

case "$ACTION" in
    "1")
        exec /usr/bin/xdg-open "https://github.com/uthsarad/NeOS/discussions" >/dev/null 2>&1
        ;;
    "2")
        exec /usr/bin/xdg-open "https://github.com/uthsarad/NeOS/issues" >/dev/null 2>&1
        ;;
    "3")
        # One channel today; say what it actually is (no staging repo exists yet).
        exec /usr/bin/kdialog --icon dialog-information --title "Release Channel" --msgbox "This system follows the NeOS Beta channel: updates come directly from the Arch Linux repositories, and every update is protected by a snapshot taken before and after it.

Choosing a different channel will be possible once NeOS publishes a stable channel."
        ;;
    "4")
        if command -v drkonqi >/dev/null 2>&1; then
            if kdialog --icon dialog-information --title "Configure Crash Reporting" \
                --yesno "NeOS is telemetry-free by default. Crash reporting sends a report only when a program crashes, and only after you confirm it.

Would you like to configure crash reporting now?"; then
                exec drkonqi >/dev/null 2>&1
            fi
        else
            exec /usr/bin/kdialog --icon dialog-information --title "Crash Reporting Unavailable" \
                --msgbox "The automated crash reporting tool (drkonqi) is not currently installed or is unavailable in this session.

System stability remains unaffected."
        fi
        ;;
    "5")
        if command -v snapper >/dev/null 2>&1; then
            TEMP_FILE=$(mktemp "${TMPDIR:-/tmp}/snaps.XXXXXX")
            # Single quotes: the trap must expand $TEMP_FILE when it fires, not
            # when the trap is installed (SC2064).
            trap 'rm -f "$TEMP_FILE"' EXIT INT TERM
            snapper list > "$TEMP_FILE" 2>&1
            mapfile -t SNAP_LINES < "$TEMP_FILE"
            if [ ${#SNAP_LINES[@]} -le 2 ]; then
                rm -f "$TEMP_FILE"
                exec /usr/bin/kdialog --icon dialog-information --title "System Snapshots" --msgbox "No system snapshots found.

Snapshots are typically created automatically during system updates."
            else
                /usr/bin/kdialog --icon dialog-information --title "System Snapshots (Read-Only)" --textbox "$TEMP_FILE" 600 400

                # Rollback flow
                if ROLLBACK_ID=$(kdialog --icon dialog-warning --title "System Rollback" --inputbox "Enter the numeric ID of the snapshot to rollback to (or cancel to exit):") \
                    && [ -n "$ROLLBACK_ID" ]; then
                    if [[ "$ROLLBACK_ID" =~ ^[0-9]+$ ]]; then
                        if kdialog --icon dialog-warning --title "Confirm Rollback" --yesno "Snapshot $ROLLBACK_ID will become the system after the next reboot. Changes to the system since then are set aside (your home folder is not affected); the current state is kept and can be restored.

Are you sure you want to proceed?"; then
                            PROGRESS=$(kdialog --progressbar "Executing system rollback..." 100)
                            ROLLBACK_STATUS=0
                            # Not `snapper rollback`: it switches the btrfs default
                            # subvolume, which NeOS never boots from (root is
                            # mounted by path, subvol=/@). See neos-rollback.
                            /usr/bin/pkexec --disable-internal-agent /usr/local/bin/neos-rollback "$ROLLBACK_ID" || ROLLBACK_STATUS=$?
                            close_progress "$PROGRESS"
                            if (( ROLLBACK_STATUS == 0 )); then
                                kdialog --icon dialog-information --title "Rollback Successful" --msgbox "Snapshot $ROLLBACK_ID has been restored. Reboot to start it."
                            else
                                /usr/bin/kdialog --icon dialog-error --title "Rollback Failed" --error "The rollback did not complete and the system was left unchanged. Details: journalctl -t neos-rollback"
                            fi
                        fi
                    else
                        /usr/bin/kdialog --icon dialog-error --title "Invalid Input" --error "Please enter a valid numeric snapshot ID."
                    fi
                fi
            fi
            rm -f "$TEMP_FILE"
        else
            exec /usr/bin/kdialog --icon dialog-error --title "Snapshot Error" --error "Snapshot management tool (snapper) is not installed."
        fi
        ;;
    "6")
        TEMP_FILE=$(mktemp "${TMPDIR:-/tmp}/license.XXXXXX")
        trap 'rm -f "$TEMP_FILE"' EXIT INT TERM
        cat << 'LICENSE_EOF' | fold -s -w 90 > "$TEMP_FILE"
MIT License

Copyright (c) 2026 NeOS

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.

---
NeOS utilizes components from Arch Linux.
Arch Linux and its packages are governed by their respective upstream licenses.
LICENSE_EOF
        /usr/bin/kdialog --icon dialog-information --title "About NeOS - System Licensing" --textbox "$TEMP_FILE" 600 400
        rm -f "$TEMP_FILE"
        ;;
    "7")
        if kdialog --icon dialog-information --title "System Update" --yesno "This will check for and install available system updates.

Proceed?"; then
            PROGRESS=$(kdialog --progressbar "Executing system update..." 100)
            UPDATE_STATUS=0
            /usr/bin/pkexec --disable-internal-agent /usr/local/bin/neos-autoupdate.sh || UPDATE_STATUS=$?
            close_progress "$PROGRESS"

            if (( UPDATE_STATUS == 0 )); then
                /usr/bin/kdialog --icon dialog-information --title "Update Complete" --msgbox "System update completed successfully."
            else
                /usr/bin/kdialog --icon dialog-error --title "Update Failed" --error "System update failed. Please check the update logs in /var/log/neos-autoupdate.log."
            fi
        fi
        ;;
esac