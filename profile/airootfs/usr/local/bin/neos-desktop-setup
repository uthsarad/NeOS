#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
if [[ ! -f "$HOME/.neos_polished" ]]; then
    # Set Breeze Dark as the base look-and-feel
    plasma-apply-lookandfeel -a org.kde.breezedark.desktop 2>/dev/null || true

    # Apply the NeOS color scheme over it so the desktop matches the
    # installer, login screen and boot splash (navy + accent blue).
    plasma-apply-colorscheme NeOS 2>/dev/null || true

    # Set wallpaper
    if [[ -f /usr/share/backgrounds/neos-wallpaper.png ]]; then
        plasma-apply-wallpaperimage /usr/share/backgrounds/neos-wallpaper.png 2>/dev/null || true
    fi

    # Windows Familiarity: configure double-click to open files/folders in KDE
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kdeglobals --group KDE --key SingleClick false
        kwriteconfig6 --file dolphinrc --group General --key ShowFullPathInTitlebar true
    elif command -v kwriteconfig5 >/dev/null 2>&1; then
        kwriteconfig5 --file kdeglobals --group KDE --key SingleClick false
        kwriteconfig5 --file dolphinrc --group General --key ShowFullPathInTitlebar true
    fi

    # Ensure Flathub repository is pre-configured for Flatpak applications
    if command -v flatpak >/dev/null 2>&1; then
        flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
    fi

    # Ensure desktop launchers are executable/trusted on desktop
    for launcher in welcome-neos.desktop neos-terminal.desktop; do
        if [[ -L "$HOME/Desktop" ]] || [[ -L "$HOME/Desktop/$launcher" ]]; then
            continue
        fi
        if [[ -f "$HOME/Desktop/$launcher" ]]; then
            chmod +x "$HOME/Desktop/$launcher"
        fi
    done

    # Create user directories
    xdg-user-dirs-update 2>/dev/null || true

    # Set default browser
    xdg-settings set default-web-browser firefox.desktop 2>/dev/null || true

    touch "$HOME/.neos_polished"
fi
